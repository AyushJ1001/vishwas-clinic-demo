{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vishwas-clinic-demo",
  "account_id": "59cf833536bd9a751546ecfc2cc649e3",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vishwas-clinic-demo",
      "database_id": "8cce7291-7338-43be-9f3c-70a98c1f9790",
      "migrations_dir": "drizzle"
    }
  ],
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  }
}
